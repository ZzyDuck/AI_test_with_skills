  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./playwright-output/playwright-tests"
  },
  "include": ["playwright-output/playwright-tests/**/*.ts"],
  "exclude": ["node_modules"]
}